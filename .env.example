# Crackers Hyderabad — environment template.
# Copy to `.env` (server, local KVM/production) — never commit real values.
# Browser variables live in `client/.env*` (VITE_*); see client/.env.example.
# Database: Firestore via Firebase Admin (no DATABASE_URL — this project has
# no PostgreSQL/SQL dependency; data lives in Firestore collections).

# =============================================
# Server (api/server.js)
# =============================================
# Set to production on the KVM (enables generic 500 messages, prod media writes).
NODE_ENV=production

# Port the Express API listens on. Hostinger KVM runs it under PM2 on 3001
# behind an Nginx /api reverse proxy. Always honour PORT when set.
PORT=3001

# Extra browser origins allowed to call the API (comma-separated).
# Defaults already cover localhost, crackershyderabad.com, www,
# admin.crackershyderabad.com and billing.crackershyderabad.com.
# CLIENT_URL / CORS_ORIGIN / FRONTEND_URL are aliases for the same allow-list —
# set whichever name your panel/docs use. ALLOWED_ORIGINS takes precedence.
ALLOWED_ORIGINS=
CLIENT_URL=
CORS_ORIGIN=

# Firebase Admin SDK (REQUIRED for api auth, orders, users).
# Paste the whole service-account JSON on one line, or place the file at
# ./service-account.json for local development only (it is git-ignored).
FIREBASE_SERVICE_ACCOUNT_KEY=
# Optional override; defaults to the project_id inside the service account.
FIREBASE_PROJECT_ID=standard-crackers-store

# Media storage (Hostinger KVM). Defaults serve production already:
# MEDIA_ROOT=/var/www/crackershyderabad-media
# MEDIA_PUBLIC_BASE=https://crackershyderabad.com/uploads
# UPLOAD_DIR is an alias for MEDIA_ROOT (use either name).
# KVM_MEDIA_ROOT is a legacy alias — prefer MEDIA_ROOT.
MEDIA_ROOT=
UPLOAD_DIR=
# KVM_MEDIA_ROOT=
MEDIA_PUBLIC_BASE=

# Geocoding provider for the checkout address picker (optional).
# Empty = OpenStreetMap Nominatim. Set a key to use Google Geocoding.
GOOGLE_GEOCODING_API_KEY=

# Analytics tuning (all optional — sensible defaults are built in).
# Minutes to offset analytics day boundaries from UTC (IST = 330).
# ANALYTICS_TZ_OFFSET_MINUTES=330
# Set to 1 to trust CDN edge geo headers for visitor country lookup.
# TRUST_EDGE_GEO=0

# =============================================
# Email (order invoices sent to customers)
# =============================================
# Legacy names — still honoured as fallback. Prefer the SMTP_* names below.
# For Gmail: enable 2-Step Verification, then create an App Password and
# use that 16-character password below (spaces optional).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your.gmail.address@gmail.com
EMAIL_PASS=

# =============================================
# Transactional order emails (auto confirmation after checkout)
# =============================================
# Master switch. false = checkout works normally, no mail is attempted.
EMAIL_ENABLED=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

SMTP_USER=crackershyderabad@gmail.com
# Gmail App Password (16 characters) — NEVER the normal account password.
# Lives ONLY in the production server .env, never in git.
SMTP_PASSWORD=

EMAIL_FROM_NAME=Crackers Hyderabad
EMAIL_FROM_ADDRESS=crackershyderabad@gmail.com

# Store inbox for the "New Order Placed" notification sent once per new order,
# alongside the customer confirmation. Never a customer address.
ADMIN_NOTIFICATION_EMAIL=admin.crackershyderabad@gmail.com
# Base URL for the admin "VIEW ORDER" button. Must be the login-gated staff
# origin (https://admin.crackershyderabad.com) — never a token-bearing link.
ADMIN_BASE_URL=https://admin.crackershyderabad.com

# Base URL used for the "Track Your Order" button in emails.
TRACK_BASE_URL=https://crackershyderabad.com

# =============================================
# MSG91 SMS (order confirmation + status updates)
# =============================================
# Get your auth key from https://control.msg91.com (API & Developers > API Key).
MSG91_AUTH_KEY=
MSG91_SENDER_ID=CRAKER
MSG91_ROUTE=4

# =============================================
# Deploy (Hostinger KVM auto-deploy, GitHub Secrets)
# =============================================
# DEPLOY_TOKEN — random token shared with /root/crackers-deploy/.deploy-token
# DEPLOY_HOST  — hostname serving /api/deploy, e.g. crackershyderabad.com
DEPLOY_TOKEN=
DEPLOY_HOST=

# =============================================
# Browser build (Vite — set as GitHub/Vercel env vars in CI)
# =============================================
# These are PUBLIC and ship inside the browser bundle by design.
# CI falls back to client/.env.production when secrets are absent.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Same-origin API proxy on both hosts. Leave as /api.
# VITE_API_URL is accepted as a fallback alias; VITE_BACKEND_API_URL wins.
VITE_BACKEND_API_URL=/api
VITE_API_URL=/api
