VITE_FIREBASE_AUTH_DOMAIN=standard-crackers-store.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=standard-crackers-store
VITE_FIREBASE_MESSAGING_SENDER_ID=135905252789
VITE_FIREBASE_APP_ID=1:135905252789:web:3a3fbf40606a58329f35fc

# Same-origin API proxy in production. Local development overrides this in
# client/.env.local and therefore never persists media on the development PC.
VITE_BACKEND_API_URL=/api

# Google Analytics 4 measurement ID. Public frontend configuration — it ships
# inside the browser bundle by design (like the Firebase web keys above), so
# it is committed here for deterministic builds. Hosting env may override it.
VITE_GA_MEASUREMENT_ID=G-M6GVVQSN7T
