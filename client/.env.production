# Production build environment (loaded by `vite build` = mode "production").
# Overrides client/.env and client/.env.local so every deploy — CI (GitHub
# Actions), Vercel, or a local build — produces the SAME bundle that targets
# the real production API. Never put server-only secrets here.
#
# Firebase web config is public and ships in the browser bundle by design.
VITE_FIREBASE_API_KEY=AIzaSyDaXvxLzEeFriQHIYghHIafmFsN4zDUkkc
VITE_FIREBASE_AUTH_DOMAIN=standard-crackers-store.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=standard-crackers-store
VITE_FIREBASE_MESSAGING_SENDER_ID=135905252789
VITE_FIREBASE_APP_ID=1:135905252789:web:3a3fbf40606a58329f35fc

# Production API = Hostinger KVM. Nginx maps https://crackershyderabad.com/api/*
# to the PM2 Express app (crackers-api :3001) and serves /uploads from
# /var/www/crackershyderabad-media. No localhost in production bundles.
VITE_BACKEND_API_URL=/api

# Google Analytics 4 measurement ID (public; see client/.env). Repeated here
# so production builds carry the same property even if .env handling changes.
VITE_GA_MEASUREMENT_ID=G-M6GVVQSN7T
