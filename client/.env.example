# Firebase Configuration
# Get these from Firebase Console → Project Settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Production uses the same-origin reverse proxy. Development may override this
# in .env.local (for example, https://crackershyderabad.com).
VITE_BACKEND_API_URL=/api

# Google Analytics 4 measurement ID (public frontend configuration — safe to
# expose, but keep the actual id in real .env files / hosting env, never
# hardcoded in code). Single property for the storefront.
# When empty or unset, GA4 stays disabled and the shop works unchanged.
VITE_GA_MEASUREMENT_ID=
