{
  "name": "workspace",
  "version": "1.0.0",
  "description": "A production-ready e-commerce website for selling crackers and fireworks, built with React, Firebase, TailwindCSS, and Framer Motion.",
  "main": "index.js",
  "scripts": {
    "dev": "npm run dev --prefix client",
    "dev:admin": "npm run dev --prefix admin",
    "dev:billing": "npm run dev --prefix billing",
    "dev:api": "npm run dev --prefix api",
    "build": "npm run build --prefix client",
    "build:admin": "npm run build --prefix admin",
    "build:billing": "npm run build --prefix billing",
    "preview": "npm run preview --prefix client",
    "lint": "npm run lint --prefix client",
    "lint:admin": "npm run lint --prefix admin",
    "lint:billing": "npm run lint --prefix billing",
    "start:api": "npm run start --prefix api",
    "test": "node --test tests/order-id.test.js tests/order-totals.test.js tests/email-flow.test.js tests/whatsapp.test.js tests/storefront-whatsapp.test.js tests/storefront-seo.test.js tests/price-list.test.js",
    "test:order-id": "node --test tests/order-id.test.js",
    "test:rules": "vitest run tests/firestore-rules.test.js",
    "test:email": "node tests/email-flow.test.js",
    "email:diagnose": "node scripts/email-config-diagnostic.js",
    "email:migrate": "node scripts/migrate-email-env-to-primary.js",
    "email:test-order": "node scripts/test-order-email-flow.js",
    "test:email:send": "node scripts/send-test-order-email.js",
    "test:email:preview": "node scripts/send-test-order-email.js --dry-run",
    "migrate:homepage": "node scripts/migrate-homepage-order.js",
    "verify:homepage": "node scripts/verify-homepage-admin.js",
    "test:recommendations": "node scripts/test-recommendations.js",
    "migrate:catalog": "node scripts/migrateCatalogToKvm.js --dry-run",
    "migrate:catalog:apply": "node scripts/migrateCatalogToKvm.js --apply",
    "migrate:roles": "node scripts/migrate-roles.js",
    "migrate:roles:apply": "node scripts/migrate-roles.js --commit",
    "sitemap": "node scripts/generate-sitemap.js",
    "sitemap:dry-run": "node scripts/generate-sitemap.js --dry-run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase-admin": "^14.2.0",
    "multer": "^2.2.0",
    "nodemailer": "^10.1.0",
    "sharp": "^0.35.3"
  },
  "overrides": {
    "jose": "^5.9.6",
    "uuid": "^11.1.1",
    "glob": "^13.0.6",
    "rimraf": "^6.1.3"
  },
  "allowScripts": {
    "@firebase/util@1.15.2": true,
    "protobufjs@7.6.5": true
  }
}
